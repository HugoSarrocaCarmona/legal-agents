      "PowerShell(Clear-Content *Inputs*)",
      "PowerShell(Set-Content *Inputs*)",
      "PowerShell(Out-File *Inputs*)",
      "PowerShell(git clean *x*)"
    ],
    "ask": [
      "Bash(mv *Inputs*)",
      "PowerShell(Move-Item *Inputs*)",
      "PowerShell(Rename-Item *Inputs*)"
    ]
  }
